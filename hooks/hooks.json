{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/ensure-worker.cjs" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/dispatch.cjs SessionStart" }
        ]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/dispatch.cjs UserPromptSubmit" } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/dispatch.cjs PreToolUse" } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/dispatch.cjs PostToolUse" } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/dispatch.cjs SubagentStart" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/dispatch.cjs SubagentStop" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/dispatch.cjs Stop" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/dispatch.cjs SessionEnd" } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/dispatch.cjs PreCompact" } ] }
    ]
  }
}
